---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RestaurantFeatureCard from '../components/RestaurantFeatureCard.astro';
import TierBadge from '../components/TierBadge.astro';
import { popularRegions, homeCategories, categories, regions, getCategory, getRegion, tiers } from '../lib/taxonomy';

const allRestaurants = await getCollection('restaurants');
const totalCount = allRestaurants.length;

const tierOrder = (tierId: string) => tiers.find((t) => t.id === tierId)?.order ?? 99;

// 「附近推薦」：全部店家依「分級 → 有封面照 → 最近複核日期」排序；
// 先顯示前 9 家，可依分類篩選、按「顯示更多」繼續看（篩選與分頁在前端處理）。
const FEATURED_PAGE = 9;
const featured = allRestaurants.slice().sort((a, b) => {
  const tierDiff = tierOrder(a.data.tierId) - tierOrder(b.data.tierId);
  if (tierDiff !== 0) return tierDiff;
  const photoDiff = Number(Boolean(b.data.coverImage)) - Number(Boolean(a.data.coverImage));
  if (photoDiff !== 0) return photoDiff;
  return (b.data.lastReviewedAt ?? '').localeCompare(a.data.lastReviewedAt ?? '');
});
// 篩選按鈕：只列出有店家的分類（首頁分類在前，其餘依分類順序）
const featuredCategoryIds = new Set(allRestaurants.map((r) => r.data.categoryId));
const filterCategories = [
  ...homeCategories.filter((c) => featuredCategoryIds.has(c.id)),
  ...categories.filter((c) => !c.showOnHome && featuredCategoryIds.has(c.id)),
];

// 「本週人氣小吃」：目前站上沒有收藏數／打卡數統計，改以分級 + 最近複核日期排序，
// 呈現「編輯精選」而非虛構的熱門數字。
const ranking = allRestaurants
  .slice()
  .sort((a, b) => {
    const tierDiff = tierOrder(a.data.tierId) - tierOrder(b.data.tierId);
    if (tierDiff !== 0) return tierDiff;
    return (b.data.lastReviewedAt ?? '').localeCompare(a.data.lastReviewedAt ?? '');
  })
  .slice(0, 6);

const topPick = featured[0] ?? null;
const topPickRegion = topPick ? getRegion(topPick.data.regionId) : null;
const topPickDistrict = topPickRegion?.districts.find((d) => d.id === topPick?.data.districtId);

// 城市指南：列出所有縣市（依北→南→東排序），附編輯導語與收錄店家數（導語為原創文案，非第三方內容）。
// 之後新增的縣市會自動出現；沒有導語的縣市顯示預設文字。
const cityTaglines: Record<string, string> = {
  taipei: '巷弄麵攤與老派冰室',
  'new-taipei': '夜市與老街小吃',
  hsinchu: '米粉貢丸與客家味',
  taichung: '市場小吃一路吃到宵夜',
  nantou: '山城羊肉與日月潭風味',
  chiayi: '火雞肉飯的故鄉',
  tainan: '早餐從牛肉湯開始',
  kaohsiung: '港邊海鮮與鹽埕老味',
  pingtung: '肉圓豬腳到恆春海味',
  hualien: '扁食麻糬與山海味',
  taitung: '縱谷米香與海岸風味',
};
const cityOrder = [
  'keelung', 'taipei', 'new-taipei', 'taoyuan', 'hsinchu', 'miaoli', 'taichung', 'changhua', 'nantou',
  'yunlin', 'chiayi', 'tainan', 'kaohsiung', 'pingtung', 'yilan', 'hualien', 'taitung', 'penghu', 'kinmen', 'lienchiang',
];
const regionCounts = new Map<string, number>();
for (const r of allRestaurants) regionCounts.set(r.data.regionId, (regionCounts.get(r.data.regionId) ?? 0) + 1);
const orderOf = (id: string) => (cityOrder.indexOf(id) === -1 ? 999 : cityOrder.indexOf(id));
const cityGuide = [...regions].sort((a, b) => orderOf(a.id) - orderOf(b.id));
---
<BaseLayout title="首頁">
  <section class="hero">
    <div class="hero-copy">
      <div class="badge">
        <span class="dot"></span>
        已收錄 {totalCount} 家店家資訊，持續新增中
      </div>
      <h1>找到附近<br />最對味的那一攤</h1>
      <p class="lede">從巷口麵攤到老字號餐廳，依你的地區、分類與分級，挑出真正值得排隊的那一家。</p>
      <form class="search" action="/search" method="get" id="search-form">
        <div class="search-field" data-field="location">
          <button type="button" class="field-trigger" aria-expanded="false" aria-haspopup="listbox">
            <span class="label">地點</span>
            <span class="value" data-summary>全台</span>
          </button>
          <div class="dropdown-panel" role="listbox" aria-label="選擇地區" hidden>
            {regions.map((r) => (
              <div class="dropdown-group">
                <label class="group-label">
                  <input type="checkbox" class="parent-checkbox" data-parent={r.id} />
                  {r.name}
                </label>
                <div class="child-list">
                  {r.districts.map((d) => (
                    <label class="child-label">
                      <input
                        type="checkbox"
                        class="child-checkbox"
                        data-parent={r.id}
                        name="district"
                        value={`${r.id}:${d.id}`}
                      />
                      {d.name}
                    </label>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="search-field" data-field="category">
          <button type="button" class="field-trigger" aria-expanded="false" aria-haspopup="listbox">
            <span class="label">餐點類型</span>
            <span class="value" data-summary>不限</span>
          </button>
          <div class="dropdown-panel" role="listbox" aria-label="選擇餐點類型" hidden>
            {categories.map((c) => (
              <div class="dropdown-group">
                <label class="group-label">
                  <input
                    type="checkbox"
                    class={c.subcategories.length > 0 ? 'parent-checkbox' : 'child-checkbox'}
                    data-parent={c.id}
                    name={c.subcategories.length > 0 ? undefined : 'category'}
                    value={c.subcategories.length > 0 ? undefined : c.id}
                  />
                  {c.name}
                </label>
                {c.subcategories.length > 0 && (
                  <div class="child-list">
                    {c.subcategories.map((sub) => (
                      <label class="child-label">
                        <input
                          type="checkbox"
                          class="child-checkbox"
                          data-parent={c.id}
                          name="category"
                          value={`${c.id}:${sub.id}`}
                        />
                        {sub.name}
                      </label>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
        <input type="text" name="q" placeholder="或輸入特定名稱：牛肉麵、滷肉飯…" />
        <button type="submit">搜尋</button>
      </form>
    </div>
    <div class="hero-visual">
      <div class="hero-image" aria-hidden="true">
        <span>放一張夜市或店內照片</span>
      </div>
      {topPick && (
        <div class="hero-callout">
          <div class="callout-label">編輯本週精選</div>
          <div class="callout-name">{topPick.data.name}</div>
          <div class="callout-meta">
            {topPickRegion?.name}・{topPickDistrict?.name}{topPick.data.priceRange ? ` ・ ${topPick.data.priceRange}` : ''}
          </div>
        </div>
      )}
    </div>
  </section>

  <section id="nearby" class="nearby">
    <div class="section-head">
      <div>
        <h2>附近推薦</h2>
        <p class="section-sub"><span id="feature-count">{featured.length}</span> 家店家 · 依分級排序</p>
      </div>
    </div>

    {filterCategories.length > 0 && (
      <div class="filter-row" role="group" aria-label="依分類篩選">
        <button type="button" class="pill is-active" data-cat="全部">全部</button>
        {filterCategories.map((c) => (
          <button type="button" class="pill" data-cat={c.name}>{c.name}</button>
        ))}
      </div>
    )}

    {featured.length > 0 ? (
      <div class="feature-grid" id="feature-grid" data-page={FEATURED_PAGE}>
        {featured.map((r) => (
          <RestaurantFeatureCard
            slug={r.id}
            name={r.data.name}
            regionId={r.data.regionId}
            districtId={r.data.districtId}
            categoryName={getCategory(r.data.categoryId)?.name ?? r.data.categoryId}
            tierId={r.data.tierId}
            description={r.data.description}
            priceRange={r.data.priceRange}
            openingHours={r.data.openingHours}
            coverImage={r.data.coverImage}
          />
        ))}
      </div>
      <div class="more-row">
        <button type="button" class="more-btn" id="feature-more">顯示更多</button>
      </div>
    ) : (
      <p class="empty">店家資料建置中，很快就會有第一批推薦名單。</p>
    )}
  </section>

  <section id="ranking" class="ranking">
    <div class="section-head">
      <div>
        <h2>本週人氣小吃</h2>
        <p class="section-sub">編輯依分級與最近複核日期挑選，每週更新</p>
      </div>
      <a href="/category">看完整分類</a>
    </div>
    {ranking.length > 0 ? (
      <div class="ranking-grid">
        {ranking.map((r, i) => {
          const region = getRegion(r.data.regionId);
          const district = region?.districts.find((d) => d.id === r.data.districtId);
          return (
            <a href={`/restaurant/${r.id}`} class="ranking-row">
              <span class="no">{String(i + 1).padStart(2, '0')}</span>
              <div class="ranking-info">
                <div class="ranking-name">{r.data.name}</div>
                <div class="ranking-where">{region?.name}・{district?.name}</div>
              </div>
              <TierBadge tierId={r.data.tierId} />
            </a>
          );
        })}
      </div>
    ) : (
      <p class="empty">目前還沒有可以排行的店家，敬請期待。</p>
    )}
  </section>

  <section id="cities" class="cities">
    <h2>城市指南</h2>
    <p class="section-sub">在地編輯挑選的路線，一天吃透一座城</p>
    <div class="city-grid">
      {cityGuide.map((region) => (
        <a href={`/region/${region.id}`} class={`city-card${regionCounts.get(region.id) ? '' : ' is-empty'}`}>
          <span class="city-count">
            {regionCounts.get(region.id) ? `${regionCounts.get(region.id)} 家` : '即將收錄'}
          </span>
          <span class="city-name">{region.name}</span>
          <span class="city-desc">{cityTaglines[region.id] ?? '在地小吃與老店'}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  // 附近推薦：分類篩選 + 「顯示更多」分頁
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-row .pill');
  const grid = document.getElementById('feature-grid');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#feature-grid [data-category]'));
  const moreBtn = document.getElementById('feature-more') as HTMLButtonElement | null;
  const countEl = document.getElementById('feature-count');
  const pageSize = Number(grid?.dataset.page ?? 9);
  let currentCat = '全部';
  let shown = pageSize;
  const render = () => {
    const matches = cards.filter((c) => currentCat === '全部' || c.dataset.category === currentCat);
    cards.forEach((c) => (c.style.display = 'none'));
    matches.slice(0, shown).forEach((c) => (c.style.display = ''));
    if (countEl) countEl.textContent = String(matches.length);
    if (moreBtn) {
      moreBtn.hidden = matches.length <= shown;
      moreBtn.textContent = `顯示更多（還有 ${matches.length - shown} 家）`;
    }
  };
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      currentCat = btn.dataset.cat ?? '全部';
      shown = pageSize;
      render();
    });
  });
  moreBtn?.addEventListener('click', () => {
    shown += pageSize;
    render();
  });
  render();

  // 地點／餐點類型 多選下拉選單
  const fields = document.querySelectorAll<HTMLElement>('.search-field');

  function closeAllPanels(except?: HTMLElement) {
    fields.forEach((field) => {
      if (field === except) return;
      const trigger = field.querySelector<HTMLButtonElement>('.field-trigger');
      const panel = field.querySelector<HTMLElement>('.dropdown-panel');
      trigger?.setAttribute('aria-expanded', 'false');
      if (panel) panel.hidden = true;
    });
  }

  fields.forEach((field) => {
    const trigger = field.querySelector<HTMLButtonElement>('.field-trigger');
    const panel = field.querySelector<HTMLElement>('.dropdown-panel');
    const summaryEl = field.querySelector<HTMLElement>('[data-summary]');
    const defaultLabel = summaryEl?.textContent ?? '';
    if (!trigger || !panel) return;

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      closeAllPanels(field);
      trigger.setAttribute('aria-expanded', String(!isOpen));
      panel.hidden = isOpen;
    });

    const parentBoxes = panel.querySelectorAll<HTMLInputElement>('.parent-checkbox');
    const childBoxes = panel.querySelectorAll<HTMLInputElement>('.child-checkbox');

    function childrenOf(parentId: string) {
      return panel!.querySelectorAll<HTMLInputElement>(`.child-checkbox[data-parent="${parentId}"]`);
    }

    function updateSummary() {
      const checkedChildren = Array.from(childBoxes).filter((c) => c.checked);
      if (checkedChildren.length === 0) {
        if (summaryEl) summaryEl.textContent = defaultLabel;
        return;
      }
      const label = checkedChildren[0].closest('label');
      const firstText = label ? label.textContent!.trim() : '';
      if (summaryEl) {
        summaryEl.textContent =
          checkedChildren.length === 1 ? firstText : `${firstText} 等 ${checkedChildren.length} 項`;
      }
    }

    parentBoxes.forEach((parentBox) => {
      const parentId = parentBox.dataset.parent!;
      parentBox.addEventListener('change', () => {
        childrenOf(parentId).forEach((child) => {
          child.checked = parentBox.checked;
        });
        updateSummary();
      });
    });

    childBoxes.forEach((childBox) => {
      childBox.addEventListener('change', () => {
        const parentId = childBox.dataset.parent!;
        const parentBox = panel!.querySelector<HTMLInputElement>(`.parent-checkbox[data-parent="${parentId}"]`);
        if (parentBox) {
          const siblings = Array.from(childrenOf(parentId));
          const checkedCount = siblings.filter((c) => c.checked).length;
          parentBox.checked = checkedCount === siblings.length;
          parentBox.indeterminate = checkedCount > 0 && checkedCount < siblings.length;
        }
        updateSummary();
      });
    });
  });

  document.addEventListener('click', () => closeAllPanels());
  document.querySelectorAll<HTMLElement>('.dropdown-panel').forEach((panel) => {
    panel.addEventListener('click', (e) => e.stopPropagation());
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllPanels();
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 56px;
    align-items: center;
    padding: 56px 0 40px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 14px;
    background: var(--surface-1);
    border-radius: 999px;
    font-size: 13px;
    color: #7a5a3a;
    letter-spacing: 0.5px;
    margin-bottom: 24px;
  }
  .badge .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .hero h1 {
    font-weight: 900;
    font-size: 52px;
    line-height: 1.18;
    margin: 0 0 18px;
    letter-spacing: -1px;
  }
  .lede {
    font-size: 16px;
    line-height: 1.85;
    color: var(--text-secondary);
    margin: 0 0 30px;
    max-width: 460px;
  }
  .search {
    display: flex;
    align-items: stretch;
    background: var(--surface-0);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 8px;
    box-shadow: 0 10px 30px -18px rgba(58, 40, 22, 0.35);
    max-width: 720px;
    width: 100%;
  }
  .search-field {
    position: relative;
    flex: 0 0 128px;
    border-right: 1px solid var(--surface-2);
  }
  .field-trigger {
    all: unset;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 14px;
    width: 100%;
    cursor: pointer;
    border-radius: 8px;
  }
  .field-trigger:hover,
  .field-trigger[aria-expanded='true'] {
    background: var(--surface-2);
  }
  .field-trigger .label {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }
  .field-trigger .value {
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dropdown-panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 260px;
    max-height: 340px;
    overflow-y: auto;
    background: var(--surface-0);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 14px 34px -18px rgba(58, 40, 22, 0.4);
    padding: 12px;
    z-index: 20;
  }
  .dropdown-group {
    margin-bottom: 10px;
  }
  .dropdown-group:last-child {
    margin-bottom: 0;
  }
  .group-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    padding: 4px 0;
  }
  .child-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 4px 0 0 24px;
  }
  .child-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 3px 0;
  }
  .search-field input[type='checkbox'] {
    accent-color: var(--accent);
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }
  .search input[type='text'] {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    padding: 0 16px;
    font-size: 15px;
    font-family: 'Noto Sans TC', sans-serif;
    background: transparent;
    color: var(--text-primary);
  }
  .search button[type='submit'] {
    border: 0;
    background: var(--accent);
    color: #fff;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 15px;
    font-weight: 500;
    padding: 0 24px;
    border-radius: 9px;
    cursor: pointer;
  }
  .search button[type='submit']:hover {
    background: var(--accent-hover);
  }
  .hero-visual {
    position: relative;
  }
  .hero-image {
    position: relative;
    height: 380px;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--surface-1), var(--surface-2));
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-image span {
    font-family: 'Noto Serif TC', serif;
    color: var(--text-muted);
    font-size: 15px;
  }
  .hero-callout {
    position: absolute;
    bottom: -24px;
    left: -12px;
    background: var(--surface-0);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px 20px;
    box-shadow: 0 14px 34px -20px rgba(58, 40, 22, 0.4);
    max-width: 260px;
  }
  .callout-label {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }
  .callout-name {
    font-family: 'Noto Serif TC', serif;
    font-weight: 700;
    font-size: 17px;
  }
  .callout-meta {
    font-size: 13px;
    color: var(--text-secondary);
    margin-top: 4px;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }
  .section-head h2 {
    font-weight: 700;
    font-size: 30px;
    margin: 0 0 8px;
  }
  .section-sub {
    margin: 0;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .nearby {
    padding-top: 64px;
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 28px;
  }
  .pill {
    padding: 9px 18px;
    border-radius: 999px;
    font-size: 14px;
    font-family: 'Noto Sans TC', sans-serif;
    cursor: pointer;
    background: var(--surface-0);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }
  .pill.is-active {
    background: var(--text-primary);
    color: var(--bg-page);
    border-color: var(--text-primary);
  }
  .more-row {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }
  .more-btn {
    padding: 10px 22px;
    border-radius: 999px;
    border: 1px solid var(--border-strong, #dccdb6);
    background: var(--surface-0, #fff);
    color: var(--text-primary);
    font-size: 14px;
    cursor: pointer;
  }
  .more-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .more-btn[hidden] {
    display: none;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .ranking {
    margin-top: 72px;
    background: var(--surface-2);
    border-radius: 22px;
    padding: 40px 36px;
  }
  .ranking-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 48px;
  }
  .ranking-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
  }
