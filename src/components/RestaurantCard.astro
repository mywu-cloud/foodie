---
import TierBadge from './TierBadge.astro';
import { getRegion } from '../lib/taxonomy';

interface Props {
  slug: string;
  name: string;
  regionId: string;
  districtId: string;
  categoryName: string;
  tierId: string;
}
const { slug, name, regionId, districtId, categoryName, tierId } = Astro.props;
const region = getRegion(regionId);
const district = region?.districts.find((d) => d.id === districtId);
---
<a href={`/restaurant/${slug}`} class="restaurant-card">
  <div class="thumb" aria-hidden="true">{name.slice(0, 1)}</div>
  <div class="info">
    <p class="name">{name}</p>
    <p class="meta">{region?.name}・{district?.name}・{categoryName}</p>
  </div>
  <TierBadge tierId={tierId} />
</a>

<style>
  .restaurant-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--surface-0, #fff);
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 14px;
    padding: 12px 16px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .restaurant-card:hover {
    border-color: var(--border-strong, #dccdb6);
    color: inherit;
  }
  .thumb {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    background: var(--surface-1, #f1e7d8);
    color: var(--text-muted, #9a8e80);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Noto Serif TC', serif;
    font-weight: 700;
    font-size: 16px;
  }
  .info {
    flex: 1;
    min-width: 0;
  }
  .name {
    font-size: 15px;
    font-weight: 500;
    margin: 0;
  }
  .meta {
    font-size: 12px;
    color: var(--text-muted, #888);
    margin: 2px 0 0;
  }
</style>
