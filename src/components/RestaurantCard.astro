---
import TierBadge from './TierBadge.astro';
import { getRegion } from '../lib/taxonomy';

interface Props {
  slug: string;
  name: string;
  regionId: string;
  districtId: string;
  categoryName: string;
  tierId: string;
}
const { slug, name, regionId, districtId, categoryName, tierId } = Astro.props;
const region = getRegion(regionId);
const district = region?.districts.find((d) => d.id === districtId);
---
<a href={`/restaurant/${slug}`} class="restaurant-card">
  <div class="thumb"></div>
  <div class="info">
    <p class="name">{name}</p>
    <p class="meta">{region?.name}・{district?.name}・{categoryName}</p>
  </div>
  <TierBadge tierId={tierId} />
</a>

<style>
  .restaurant-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border: 0.5px solid #e5e5e5;
    border-radius: 12px;
    padding: 10px 14px;
    text-decoration: none;
    color: inherit;
  }
  .thumb {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: #f2f2f2;
    flex-shrink: 0;
  }
  .info {
    flex: 1;
  }
  .name {
    font-size: 14px;
    font-weight: 500;
    margin: 0;
  }
  .meta {
    font-size: 12px;
    color: #888;
    margin: 2px 0 0;
  }
</style>
