---
import { getTier, tierColorTokens } from '../lib/taxonomy';

interface Props {
  tierId: string;
}
const { tierId } = Astro.props;
const tier = getTier(tierId);
const colors = tier ? tierColorTokens[tier.colorToken] : tierColorTokens.neutral;
---
{tier && (
  <span
    class="tier-badge"
    style={`background:${colors.bg};color:${colors.text};${colors.border ? `border:1px solid ${colors.border};` : ''}`}
  >
    {tier.name}
  </span>
)}

<style>
  .tier-badge {
    display: inline-flex;
    align-items: center;
    font-family: 'Noto Sans TC', sans-serif;
    font-size: 12px;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 999px;
    white-space: nowrap;
    letter-spacing: 0.5px;
  }
</style>
