---
import { getTier, tierColorTokens } from '../lib/taxonomy';

interface Props {
  tierId: string;
}
const { tierId } = Astro.props;
const tier = getTier(tierId);
const colors = tier ? tierColorTokens[tier.colorToken] : tierColorTokens.neutral;
---
{tier && (
  <span
    class="tier-badge"
    style={`background:${colors.bg};color:${colors.text};${colors.border ? `border:0.5px solid ${colors.border};` : ''}`}
  >
    {tier.name}
  </span>
)}

<style>
  .tier-badge {
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 8px;
    white-space: nowrap;
  }
</style>
