---
interface Subcategory {
  id: string;
  name: string;
}
interface Props {
  id: string;
  name: string;
  subcategories?: Subcategory[];
}
const { id, name, subcategories = [] } = Astro.props;
---
<div class="category-card">
  <a href={`/category/${id}`} class="category-main">{name}</a>
  {subcategories.length > 0 && (
    <details class="subcategories">
      <summary>展開細分類</summary>
      <ul>
        {subcategories.map((sub) => (
          <li><a href={`/category/${id}/${sub.id}`}>{sub.name}</a></li>
        ))}
      </ul>
    </details>
  )}
</div>

<style>
  .category-card {
    background: var(--surface-2, #f7f7f5);
    border: 1px solid var(--border, transparent);
    border-radius: 12px;
    padding: 14px 10px;
    text-align: center;
    transition: border-color 0.15s ease;
  }
  .category-card:hover {
    border-color: var(--border-strong, #dccdb6);
  }
  .category-main {
    display: block;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    color: var(--text-primary, inherit);
  }
  .subcategories summary {
    font-size: 11px;
    color: var(--text-muted, #888);
    cursor: pointer;
    margin-top: 8px;
  }
  .subcategories ul {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .subcategories a {
    font-size: 12px;
    text-decoration: none;
    color: var(--text-secondary, inherit);
  }
</style>
